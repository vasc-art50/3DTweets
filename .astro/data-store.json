[["Map",1,2,97,98],"docs",["Map",3,4,21,22,40,41,59,60,78,79],"index",{"id":3,"data":5,"body":18,"filePath":19,"digest":20,"deferredRender":8},{"title":6,"description":7,"editUrl":8,"head":9,"template":10,"hero":11,"sidebar":15,"pagefind":8,"draft":16},"Úvod","Tweak your world! 3D design, vývoj a tisk podle vašich představ.",true,[],"splash",{"title":12,"tagline":13,"actions":14},"3DTweets","\u003Cstrong>Tweak\u003C/strong> your world!",[],{"hidden":16,"attrs":17},false,{},"\u003Csection className=\"home-section about-grid\" id=\"o-nas\">\r\n  \u003Cdiv>\r\n    \u003Ch2>O nás\u003C/h2>\r\n    \u003Cp>\r\n      3DTweets je mladý tým, který propojuje 3D design, vývoj a tisk. Baví nás\r\n      proměňovat nápady v užitečné, originální a kvalitně zpracované výrobky.\r\n    \u003C/p>\r\n    \u003Cp>\r\n      Hledáme nejlepší rovnováhu mezi kvalitou, funkčností a časem, který do\r\n      každého projektu vložíme.\r\n    \u003C/p>\r\n    \u003Cp>\u003Ca href=\"/o-nas/\">Číst dále →\u003C/a>\u003C/p>\r\n  \u003C/div>\r\n\r\n  \u003Cdiv className=\"service-grid\">\r\n    \u003Cdiv className=\"service\">\r\n      \u003Csvg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\r\n        \u003Cpath d=\"M12 37 8 40l3-9L31 11l6 6-20 20-5 1Z\" />\r\n        \u003Cpath d=\"m27 15 6 6M8 44h32\" />\r\n      \u003C/svg>\r\n      \u003Ch3>Design\u003C/h3>\r\n    \u003C/div>\r\n    \u003Cdiv className=\"service\">\r\n      \u003Csvg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\r\n        \u003Cpath d=\"M11 8h26v12H11zM8 20h32v18H8zM15 27h18M15 33h12\" />\r\n        \u003Cpath d=\"M15 8V5h18v3M14 38v5h20v-5\" />\r\n      \u003C/svg>\r\n      \u003Ch3>Tisk\u003C/h3>\r\n    \u003C/div>\r\n    \u003Cdiv className=\"service\">\r\n      \u003Csvg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\r\n        \u003Cpath d=\"m24 5 5 11 12 1-9 8 3 12-11-6-11 6 3-12-9-8 12-1 5-11Z\" />\r\n      \u003C/svg>\r\n      \u003Ch3>Personalizace 3D modelů\u003C/h3>\r\n    \u003C/div>\r\n  \u003C/div>\r\n\u003C/section>\r\n\r\n\u003Csection className=\"home-section work-grid\" id=\"nase-prace\">\r\n  \u003Cdiv>\r\n    \u003Ch2>Naše práce\u003C/h2>\r\n    \u003Cp>\r\n      Navrhujeme a tiskneme vlastní modely, drobné vychytávky i dárky na míru.\r\n      Každý projekt bereme jako příležitost najít chytré řešení a dotáhnout ho\r\n      od prvního návrhu až k hotovému výtisku.\r\n    \u003C/p>\r\n    \u003Cp>\u003Ca href=\"/nase-prace/\">Prohlédnout naši práci →\u003C/a>\u003C/p>\r\n  \u003C/div>\r\n  \u003Cimg\r\n    className=\"work-photo\"\r\n    src=\"https://78ae74a1da.cbaul-cdnwnd.com/b8a020c3346e009b7b558ad5c14f343b/200000005-6a64c6a64e/images-pexels-com-photos-19835263-pexels-photo-19835263-auto-compress-cs-tinysrgb-dpr-2-h-650-w-940.jpeg?ph=78ae74a1da\"\r\n    alt=\"Detail 3D tiskárny při tisku\"\r\n    loading=\"lazy\"\r\n  />\r\n\u003C/section>\r\n\r\n\u003Csection className=\"home-section\" id=\"materialy\">\r\n  \u003Ch2>S čím pracujeme\u003C/h2>\r\n  \u003Cdiv className=\"tool-grid\">\r\n    \u003Carticle className=\"tool-card\">\r\n      \u003Ch3>3D design\u003C/h3>\r\n      \u003Cp>\r\n        Rozvíjíme naše dovednosti v programech pro návrh a úpravu 3D modelů.\r\n      \u003C/p>\r\n      \u003Cp>Onshape · Fusion 360 · Tinkercad\u003C/p>\r\n    \u003C/article>\r\n    \u003Carticle className=\"tool-card\">\r\n      \u003Ch3>Tiskárny\u003C/h3>\r\n      \u003Cp>\r\n        Začínali jsme s Ender 3 Pro, kde jsme se naučili základy tisku, údržby\r\n        i kalibrace. Od roku 2023 nám práci usnadňuje Prusa MK4.\r\n      \u003C/p>\r\n      \u003Cp>Creality · Prusa\u003C/p>\r\n    \u003C/article>\r\n    \u003Carticle className=\"tool-card\">\r\n      \u003Ch3>Materiály\u003C/h3>\r\n      \u003Cp>\r\n        Nejčastěji používáme PLA – všestranný filament, který se snadno tiskne\r\n        a nabízí široký výběr barev i povrchů.\r\n      \u003C/p>\r\n      \u003Cp>PLA · PETG\u003C/p>\r\n    \u003C/article>\r\n  \u003C/div>\r\n  \u003Cp>\u003Ca href=\"/seznam-materialu/\">Seznam mate