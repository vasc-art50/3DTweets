[["Map",1,2,98,99],"docs",["Map",3,4,21,22,41,42,60,61,79,80],"index",{"id":3,"data":5,"body":18,"filePath":19,"digest":20,"deferredRender":8},{"title":6,"description":7,"editUrl":8,"head":9,"template":10,"hero":11,"sidebar":15,"pagefind":8,"draft":16},"Úvod","Tweak your world! 3D design, vývoj a tisk podle vašich představ.",true,[],"splash",{"title":12,"tagline":13,"actions":14},"3DTweets","\u003Cstrong>Tweak\u003C/strong> your world!",[],{"hidden":16,"attrs":17},false,{},"\u003Csection class=\"home-section about-grid\" id=\"o-nas\">\r\n  \u003Cdiv>\r\n    \u003Ch2>O nás\u003C/h2>\r\n    \u003Cp>\r\n      \u003Cstrong>3DT\u003C/strong>weets je mladá a ambiciózní skupinka zaměřená na 3D\r\n      design, vývoj a tisk.\r\n    \u003C/p>\r\n    \u003Cp>\r\n      Jsme mladí a nadšeni do 3D designu, vývoje a tisku. Jsme připraveni na\r\n      jakoukoliv výzvu k vytváření inovativních a kvalitních produktů díky\r\n      našim schopnostem v oblasti 3D tisku.\r\n    \u003C/p>\r\n    \u003Cp>\u003Ca href=\"/o-nas/\">Číst dále →\u003C/a>\u003C/p>\r\n  \u003C/div>\r\n\r\n  \u003Cdiv class=\"service-grid\">\r\n    \u003Cdiv class=\"service\">\r\n      \u003Csvg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\r\n        \u003Cpath d=\"M12 37 8 40l3-9L31 11l6 6-20 20-5 1Z\" />\r\n        \u003Cpath d=\"m27 15 6 6M8 44h32\" />\r\n      \u003C/svg>\r\n      \u003Ch3>Design\u003C/h3>\r\n    \u003C/div>\r\n    \u003Cdiv class=\"service\">\r\n      \u003Csvg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\r\n        \u003Cpath d=\"M11 8h26v12H11zM8 20h32v18H8zM15 27h18M15 33h12\" />\r\n        \u003Cpath d=\"M15 8V5h18v3M14 38v5h20v-5\" />\r\n      \u003C/svg>\r\n      \u003Ch3>Tisk\u003C/h3>\r\n    \u003C/div>\r\n    \u003Cdiv class=\"service\">\r\n      \u003Csvg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\r\n        \u003Cpath d=\"m24 5 5 11 12 1-9 8 3 12-11-6-11 6 3-12-9-8 12-1 5-11Z\" />\r\n      \u003C/svg>\r\n      \u003Ch3>Personalizace 3D modelů\u003C/h3>\r\n    \u003C/div>\r\n  \u003C/div>\r\n\u003C/section>\r\n\r\n\u003Csection class=\"home-section work-grid\" id=\"nase-prace\">\r\n  \u003Cdiv>\r\n    \u003Ch2>Naše práce\u003C/h2>\r\n    \u003Cp>\r\n      Vítejte v 3DTweets - mladé a ambiciózní skupince, která se specializuje\r\n      na 3D custom design, vývoj a tisk. Jsme připraveni čelit výzvám a hledat\r\n      nejlepší poměr kvality a vynaloženého úsilí. Náš tým je plný vášně a\r\n      kreativity, a proto jsme připraveni přinést nové a inovativní nápady do\r\n      našich projektů.\r\n    \u003C/p>\r\n    \u003Cp>\u003Ca href=\"/nase-prace/\">Číst dále →\u003C/a>\u003C/p>\r\n  \u003C/div>\r\n  \u003Cimg\r\n    class=\"work-photo\"\r\n    src=\"/images/printer-work.jpeg\"\r\n    alt=\"Detail 3D tiskárny při tisku\"\r\n    loading=\"lazy\"\r\n  />\r\n\u003C/section>\r\n\r\n\u003Csection class=\"home-section\" id=\"materialy\">\r\n  \u003Ch2>S čím pracujeme\u003C/h2>\r\n  \u003Cdiv class=\"tool-grid\">\r\n    \u003Carticle class=\"tool-card\">\r\n      \u003Ch3>3D design\u003C/h3>\r\n      \u003Cp>\r\n        Učíme se používat různé aplikace pro návrh 3D modelů a tím získávat\r\n        zkušenosti a průběžně pracovat na našem rozvoji dovedností.\r\n      \u003C/p>\r\n      \u003Cp>OnShape, Fusion360, Thinkercad\u003C/p>\r\n    \u003C/article>\r\n    \u003Carticle class=\"tool-card\">\r\n      \u003Ch3>Tiskárny\u003C/h3>\r\n      \u003Cp>\r\n        V roce 2020 jsme začali s 3D tiskárnou Ender 3 PRO. Naučili jsme se\r\n        základy 3D tisku a vše co je potřebné k údržbě, nastavení a kalibraci\r\n        tiskárny.\r\n      \u003C/p>\r\n      \u003Cp>Od roku 2023 máme MK4 tiskárnu, která nám mnohé zjednodušila a\r\n        zrychlila tvorbu 3D modelů.\u003C/p>\r\n      \u003Cp>Creality, Průša\u003C/p>\r\n    \u003C/article>\r\n    \u003Carticle class=\"tool-card\">\r\n      \u003Ch3>Materiály\u003C/h3>\r\n      \u003Cp>\r\n        PLA je univerzální materiál, se kterým se dobře pracuje.\r\n      \u003C/p>\r\n      \u003Cp>PLA\u003C/p>\r\n    \u003C/article>\r\n  \u003C/div>\r\n  \u003Cp>\u003Ca href=\"/seznam-materialu/\">Seznam materiálů, které používáme →\u003C/a>\u003C/p>\r\n\u003C/section>\r\n\r\n\u003Csection class=\"home-section contact-section\" id=\"kontakt\">\r\n  \u003Ch2>Kontakt\u003C/h2>\r\n  \u003Cp>\u003Ca href=\"mailto:3DTweets247@gmail.com\">3DTweets247@gmail.com\u003C/a>\u003C/p>\r\n\u003C/section>","src/content/docs/index.mdx","f31e10b3f6c4b1b8","nase-prace",{"id":21,"data":23,"body":30,"filePath":31,"digest":32,"rendered":33},{"title":24,"description":25,"editUrl":8,"head":26,"template":27,"sidebar":28,"pagefind":8,"draft":16},"Naše práce","Vlastní modely, tisk a malé projekty 3DTweets.",[],"doc",{"hidden":16,"attrs":29},{},"Vítejte v 3DTweets - mladé a ambiciózní skupince, která se specializuje na 3D\r\ncustom design, vývoj a tisk. Jsme připraveni na výzvy abychom naplnili naše\r\npředstavy a cíle. Náš tým je plný vášně a kreativity, a proto jsme připraveni\r\npřinést nové a inovativní nápady do našich projektů.\r\n\r\nZde najdete několik našich realizovaných projektů.\r\n\r\n\u003Cdiv class=\"model-grid work-gallery\">\r\n  \u003Ca class=\"work-project\" href=\"/images/work-charger-box.jpeg\">\r\n    \u003Cimg src=\"/images/work-charger-box.jpeg\" alt=\"Box na nabíječky\" loading=\"lazy\" />\r\n    \u003Cspan>Box na nabíječky\u003C/span>\r\n  \u003C/a>\r\n  \u003Ca class=\"work-project\" href=\"/images/work-surprise-plate.jpeg\">\r\n    \u003Cimg src=\"/images/work-surprise-plate.jpeg\" alt=\"Stojan na talířek s překvapením\" loading=\"lazy\" />\r\n    \u003Cspan>Stojan na talířek s překvapením\u003C/span>\r\n  \u003C/a>\r\n  \u003Ca class=\"work-project\" href=\"/images/dice-mixer.png\">\r\n    \u003Cimg src=\"/images/dice-mixer.png\" alt=\"Dice Mixer\" loading=\"lazy\" />\r\n    \u003Cspan>Dice Mixer\u003C/span>\r\n  \u003C/a>\r\n  \u003Ca class=\"work-project\" href=\"/images/work-cheese.jpeg\">\r\n    \u003Cimg src=\"/images/work-cheese.jpeg\" alt=\"Sýr....\" loading=\"lazy\" /