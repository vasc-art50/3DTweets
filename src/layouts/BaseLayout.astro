---
import { ClientRouter } from 'astro:transitions';
import type { CollectionEntry } from 'astro:content';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import SmallHeroBar from '../components/SmallHeroBar.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { site } from '../data/site';
import { alternateLocaleUrls, getLocale } from '../i18n/utils';
import { ui } from '../i18n/ui';
import mainStylesUrl from '../assets/styles/main.scss?url';

interface Props {
  title: string;
  description?: string;
  /** Open Graph type, e.g. "website" (default) or "article" for blog posts. */
  ogType?: string;
  /** Additional business data merged into the shared Organization schema. */
  schema?: Record<string, unknown>;
  post?: CollectionEntry<'blog'> | CollectionEntry<'blogCs'>;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  schema,
  post,
} = Astro.props;

const locale = getLocale(Astro.currentLocale);
const text = ui[locale];
const alternateUrls = alternateLocaleUrls(Astro.url.pathname);
const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fontUrl =
  'https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap';
const cloudflareBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN?.trim();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="stylesheet" href={mainStylesUrl} />

    <script is:inline>
      // Apply the theme before first paint to avoid a flash of the wrong theme.
      // No stored choice: follow the OS `prefers-color-scheme` (light default).
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)',
          ).matches;
          const theme =
            stored === 'dark' || (!stored && prefersDark) ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>

    <!-- Inter, loaded async so it never blocks first paint -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontUrl} />
    <link
      rel="stylesheet"
      href={fontUrl}
      media="print"
      onload="this.setAttribute('media', 'all')"
    />

    <!-- Canonical + Open Graph -->
    <link rel="canonical" href={canonical} />
    {
      alternateUrls && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(alternateUrls.en, Astro.site)} />
          <link rel="alternate" hreflang="cs" href={new URL(alternateUrls.cs, Astro.site)} />
        </>
      )
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

    <!-- RSS feed for the blog -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={new URL('/rss.xml', Astro.site)}
    />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>

    {
      import.meta.env.PROD && cloudflareBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareBeaconToken })}
        />
      )
    }

    <ClientRouter />

    <StructuredData schema={schema} post={post} />
  </head>
  <body>
    <a class="aw-skip-link" href="#main-content">{text.skipToContent}</a>
    <header class="aw-site-header">
      <NavBar />
      <SmallHeroBar title={title} />
    </header>
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  const updateSmallHero = () => {
    const header = document.querySelector<HTMLElement>('.aw-site-header');
    const bar = header?.querySelector<HTMLElement>('.aw-small-hero-body');
    const hero = document.querySelector<HTMLElement>('main .aw-hero, main .aw-section-head');
    if (!header || !bar || !hero) return;
    bar.classList.toggle('is-visible', hero.getBoundingClientRect().bottom <= header.getBoundingClientRect().bottom);
  };

  const headerObserver = new ResizeObserver(updateSmallHero);
  document.addEventListener('astro:page-load', () => {
    const header = document.querySelector<HTMLElement>('.aw-site-header');
    const hero = document.querySelector<HTMLElement>('main .aw-hero, main .aw-section-head');
    const eyebrow = hero?.querySelector('.aw-eyebrow, .aw-blog-journal-kicker')?.textContent?.trim();
    const display = (hero?.querySelector('.aw-display, h1') ?? document.querySelector('main h1'))?.textContent?.trim();
    const barEyebrow = header?.querySelector<HTMLElement>('.aw-small-hero-eyebrow');
    const barSeparator = header?.querySelector<HTMLElement>('.aw-small-hero-separator');
    const barDisplay = header?.querySelector<HTMLElement>('.aw-small-hero-display');
    if (barEyebrow && barSeparator && barDisplay && display) {
      barEyebrow.textContent = eyebrow ?? '';
      barSeparator.textContent = eyebrow ? ' — ' : '';
      barDisplay.textContent = display;
    }
    if (header) headerObserver.observe(header);
    if (hero) headerObserver.observe(hero);
    updateSmallHero();
  });
  document.addEventListener('astro:before-swap', () => {
    headerObserver.disconnect();
    document.querySelector('.aw-small-hero-body')?.classList.remove('is-visible');
  });
  window.addEventListener('scroll', updateSmallHero, { passive: true });
  window.addEventListener('resize', updateSmallHero, { passive: true });

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>('.aw-video__play[data-youtube-embed]');
    const embed = link?.dataset.youtubeEmbed;
    if (!link || !embed || !URL.canParse(embed)) return;
    const url = new URL(embed);
    if (url.origin !== 'https://www.youtube-nocookie.com' || !/^\/embed\/[A-Za-z0-9_-]{11}$/.test(url.pathname)) return;

    url.searchParams.set('autoplay', '1');
    const iframe = document.createElement('iframe');
    iframe.src = url.href;
    iframe.title = link.querySelector<HTMLElement>(`.aw-video__label[lang="${document.documentElement.lang === 'cs' ? 'cs' : 'en'}"]`)?.textContent ?? 'YouTube';
    iframe.loading = 'lazy';
    iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    event.preventDefault();
    link.replaceWith(iframe);
    iframe.focus();
  });
</script>
