---
// Self-contained "latest articles" section for the home page.
// Renders the three most recent blog posts and links to the full listing.
import BlogCard from './BlogCard.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../utils/reading-time';
import { getLocale, localeUrl } from '../i18n/utils';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const text = ui[locale];
const posts = (await getCollection(locale === 'cs' ? 'blogCs' : 'blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section class="section aw-section">
  <div class="container">
    <div class="aw-section-head">
      <p class="aw-eyebrow mb-2">{text.blogEyebrow}</p>
      <h2 class="title is-2">{text.blogTitle}</h2>
      <p class="subtitle is-6">{text.blogDescription}</p>
    </div>

    {
      posts.length > 0 ? (
        <div class="columns">
          {
            posts.map((post) => (
              <div class="column is-4">
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  tags={post.data.tags}
                  href={localeUrl(locale, `/blog/${post.id}`)}
                  readingTime={readingTime(post.body ?? '', locale)}
                />
              </div>
            ))
          }
        </div>
      ) : (
        <p class="has-text-centered">{text.noPosts}</p>
      )
    }

    <div class="has-text-centered mt-6">
      <a class="button is-medium is-outlined" href={localeUrl(locale, '/blog')}>{text.visitBlog}</a>
    </div>
  </div>
</section>