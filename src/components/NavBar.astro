---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';
import { getLocale, localeSwitchUrl, localeUrl } from '../i18n/utils';
import { ui } from '../i18n/ui';

const currentPath = Astro.url.pathname;
const locale = getLocale(Astro.currentLocale);
const text = ui[locale];

function isActive(path: string): boolean {
  const href = localeUrl(locale, path);
  return path === '/' ? currentPath === href : currentPath.startsWith(href);
}
---

<header>
  <nav class="navbar aw-navbar" aria-label={text.navigation}>
    <div class="container">
      <div class="navbar-brand">
        <a class="navbar-item aw-brand" href={localeUrl(locale, '/')}>
          <span class="aw-brand-mark" aria-hidden="true" style="width: 34px; height: 26px;">
            {/* Simple dumbbell mark — swap for your own logo if you have one. */}

              <svg
              viewBox="2 4.5 20 10"
              fill="currentColor"
              style="width: 46px; height: 23px; flex-shrink: 0; margin-right: 0.35rem;"
              aria-hidden="true"
              >
              <!-- Owl Head & Brows -->
              <path d="M8.4 4.8 L12 5.7 L15.6 4.8 L14.2 6.6 L12 7.5 L9.8 6.6 Z" />
              <!-- Left Eye Ring -->
              <path d="M9.8 6.4 A1.5 1.5 0 1 0 11.8 7.6 L11.2 7.2 A0.8 0.8 0 1 1 10.2 6.6 Z" />
              <!-- Right Eye Ring -->
              <path d="M14.2 6.4 A1.5 1.5 0 1 1 12.2 7.6 L12.8 7.2 A0.8 0.8 0 1 0 13.8 6.6 Z" />
              <!-- Central V-Chevron -->
              <path d="M8.2 8.4 L12 12.2 L15.8 8.4 L16.7 9.3 L12 14.0 L7.3 9.3 Z" />
              <!-- Left Wing -->
              <path d="M2.4 8.4 L8.2 8.4 L9.4 9.6 L3.6 9.6 Z" />
              <path d="M4.0 10.2 L8.6 10.2 L9.6 11.2 L5.0 11.2 Z" />
              <path d="M5.6 11.8 L9.0 11.8 L10.0 12.8 L6.6 12.8 Z" />
              <!-- Right Wing -->
              <path d="M21.6 8.4 L15.8 8.4 L14.6 9.6 L20.4 9.6 Z" />
              <path d="M20.0 10.2 L15.4 10.2 L14.4 11.2 L19.0 11.2 Z" />
              <path d="M18.4 11.8 L15.0 11.8 L14.0 12.8 L17.4 12.8 Z" />
            </svg>

          </span>
          {site.name}
        </a>

        <button
          type="button"
          class="navbar-burger"
          aria-label={text.openMenu}
          data-open-label={text.openMenu}
          data-close-label={text.closeMenu}
          aria-expanded="false"
          aria-controls="main-navbar"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>

      <div id="main-navbar" class="navbar-menu">
        <div class="navbar-end">
          {
            text.nav.map((item) => (
              <a
                class:list={['navbar-item', { 'is-active': isActive(item.path) }]}
                href={localeUrl(locale, item.path)}
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <div class="navbar-item">
            <ThemeToggle />
          </div>
          <div class="navbar-item">
            <a class="button is-primary" href={localeUrl(locale, '/contact')}>{text.discussIdea}</a>
          </div>
          <div class="navbar-item" aria-label={text.languageLabel}>
            <a
              class:list={['navbar-item', { 'is-active': locale === 'en' }]}
              href={localeSwitchUrl(currentPath, 'en')}
              lang="en"
              aria-current={locale === 'en' ? 'page' : undefined}
            >EN</a>
            <span aria-hidden="true">|</span>
            <a
              class:list={['navbar-item', { 'is-active': locale === 'cs' }]}
              href={localeSwitchUrl(currentPath, 'cs')}
              lang="cs"
              aria-current={locale === 'cs' ? 'page' : undefined}
            >CZ</a>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Bulma ships without JS, so the mobile menu toggle lives here.
  // Document-level delegation + fresh queries: with <ClientRouter /> the menu
  // DOM is re-created on every client-side navigation, but this listener and
  // the getElementById lookup still work because they resolve elements per event.
  const closeMenu = () => {
    const burger = document.querySelector<HTMLElement>('.navbar-burger');
    const menu = document.getElementById('main-navbar');
    const wasOpen = burger?.getAttribute('aria-expanded') === 'true';
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', burger?.dataset.openLabel ?? '');
    burger?.classList.remove('is-active');
    menu?.classList.remove('is-active');
    // Return focus to the trigger when the menu was open (Escape / outside click).
    if (wasOpen && document.activeElement instanceof HTMLElement) {
      burger?.focus();
    }
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const burger = target.closest<HTMLElement>('.navbar-burger');
    if (burger) {
      const isOpen = burger.getAttribute('aria-expanded') === 'true';
      const menu = document.getElementById('main-navbar');
      burger.setAttribute('aria-expanded', String(!isOpen));
      burger.setAttribute('aria-label', isOpen ? burger.dataset.openLabel ?? '' : burger.dataset.closeLabel ?? '');
      burger.classList.toggle('is-active', !isOpen);
      menu?.classList.toggle('is-active', !isOpen);
      return;
    }

    // Close the menu when a link is chosen or the click lands outside the navbar.
    if (target.closest('#main-navbar a') || !target.closest('.navbar')) {
      closeMenu();
    }
  });

  // Close the menu with Escape.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
