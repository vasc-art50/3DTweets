---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from './CtaBand.astro';
import ModelGallery from './blog/ModelGallery.astro';
import PageHero from './PageHero.astro';

interface Props {
  locale: 'en' | 'cs';
  sections: CollectionEntry<'tweetone'>[];
}

const { locale, sections } = Astro.props;
const renderedSections = await Promise.all(
  sections.map(async (section) => ({
    section,
    slug: section.id.split('/').pop()?.replace(/^\d+-/, '') ?? section.id,
    Content: (await render(section)).Content,
  })),
);
const buildPosts =
  locale === 'en' ? await getCollection('blog') : await getCollection('blogCs');
const buildSeries = buildPosts
  .filter((post) => post.id.toLowerCase().startsWith('tweetone-chapter'))
  .sort((a, b) => a.id.localeCompare(b.id));

const pageText = {
  en: {
    description:
      'A high-speed CoreXY conversion built from two Ender 3 printers, tuned for Triple-Z motion, CANbus, and practical workshop engineering.',
    heroEyebrow: 'Project case study',
    heroSubtitle:
      'A dual-Ender 3 / Ender 3 V2 conversion into a high-speed CoreXY printer with Triple-Z motion, linear rails, and a CANbus-based control stack.',
    specs: 'Project specifications',
    buildSeries: 'Six-part build series',
    buildSeriesDescription: 'Follow the full TweetONE build in the project journal.',
    son: 'Lead Engineer & Mechatronics Architect',
    father: 'Project Lead & Technical Mentor',
    ctaEyebrow: 'Keep learning',
    ctaTitle: 'The project is still evolving.',
    ctaText:
      'Browse the build notes in the blog or get in touch to discuss your own 3D prototype, printer upgrade, or product challenge.',
    ctaLabel: 'Read the blog',
  },
  cs: {
    description:
      'Rychlá tiskárna CoreXY přestavěná ze dvou tiskáren Ender 3. Využívá trojitou osu Z, lineární vedení, CANbus a praktické konstrukční řešení.',
    heroEyebrow: 'Případová studie projektu',
    heroSubtitle:
      'Přestavba tiskáren Ender 3 a Ender 3 V2 na rychlou tiskárnu CoreXY s trojitou osou Z, lineárním vedením a řízením přes CANbus.',
    specs: 'Technické parametry projektu',
    buildSeries: 'Šestidílný seriál o stavbě',
    buildSeriesDescription: 'Celou stavbu TweetONE sledujte v projektovém deníku.',
    son: 'hlavní konstruktér a architekt mechatroniky',
    father: 'vedoucí projektu a technický mentor',
    ctaEyebrow: 'Učíme se dál',
    ctaTitle: 'Projekt se stále vyvíjí.',
    ctaText:
      'Projděte si zápisy z vývoje na blogu nebo nám napište o svém 3D prototypu, úpravě tiskárny či výzvě při vývoji produktu.',
    ctaLabel: 'Přejít na blog',
  },
} as const;

const text = pageText[locale];
---

<BaseLayout title="TweetONE CoreXY" description={text.description}>
  <PageHero
    eyebrow={text.heroEyebrow}
    title="TweetONE CoreXY"
    subtitle={text.heroSubtitle}
    className="aw-tweetone-hero"
    compact
  >
    <div class="aw-tweetone-credits">
      <p><strong>{locale === 'en' ? 'Son' : 'Syn'}</strong> — {text.son}</p>
      <p><strong>{locale === 'en' ? 'Father' : 'Otec'}</strong> — {text.father}</p>
    </div>
  </PageHero>

  {
    renderedSections.map(({ section, slug, Content }, index) => {
      const data = section.data;
      const hasGallery =
        Boolean(data.heroImage) || Boolean(data.galleryFolder) || Boolean(data.gallery?.length);

      return (
        <section
          id={slug}
          class:list={[
            'section',
            'aw-section',
            'aw-tweetone-section',
            { 'aw-section-alt': data.altBackground },
          ]}
        >
          <div class="container">
            <div class="aw-section-head">
              <p class="aw-eyebrow mb-2">{data.eyebrow}</p>
              <h2 class="title aw-section-title">{data.title}</h2>
            </div>

            {index === 0 && (hasGallery || data.specs?.length) && (
              <div
                class:list={[
                  'aw-tweetone-overview',
                  { 'aw-tweetone-overview--with-gallery': hasGallery },
                ]}
              >
                {hasGallery && (
                  <div class="aw-tweetone-overview__gallery">
                    <ModelGallery post={section} />
                  </div>
                )}
                <div class="aw-tweetone-overview__details">
                  {data.specs?.length && (
                    <div class="aw-tweetone-specs">
                      <h3 class="title is-5">{text.specs}</h3>
                      <dl>
                        {data.specs.map((spec) => (
                          <div class="aw-tweetone-spec">
                            <dt>{spec.label}</dt>
                            <dd>{spec.value}</dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  )}
                  {buildSeries.length > 0 && (
                    <div class="aw-tweetone-series">
                      <h3 class="title is-5">{text.buildSeries}</h3>
                      <p>{text.buildSeriesDescription}</p>
                      <ol>
                        {buildSeries.map((post) => (
                          <li>
                            <a
                              href={
                                locale === 'en'
                                  ? `/blog/${post.id}/`
                                  : `/cs/blog/${post.id}/`
                              }
                            >
                              {post.data.title}
                            </a>
                          </li>
                        ))}
                      </ol>
                    </div>
                  )}
                </div>
              </div>
            )}

            <div class="aw-prose aw-markdown-body aw-tweetone-prose">
              <Content />
            </div>
          </div>
        </section>
      );
    })
  }

  <CtaBand
    eyebrow={text.ctaEyebrow}
    title={text.ctaTitle}
    text={text.ctaText}
    ctaLabel={text.ctaLabel}
    ctaHref={locale === 'en' ? '/blog' : '/cs/blog'}
  />
</BaseLayout>
