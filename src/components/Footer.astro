---
import { site } from '../data/site';
import { getLocale, localeUrl } from '../i18n/utils';
import { ui } from '../i18n/ui';

const year = new Date().getFullYear();
const locale = getLocale(Astro.currentLocale);
const text = ui[locale];
---

<footer class="footer aw-footer">
  <div class="container">
    <div class="columns is-multiline">
      <div class="column is-5">
        <p class="title is-5 mb-2">{site.name}</p>
        <p>{text.footerTagline}</p>
      </div>

      <div class="column is-3">
        <p class="has-text-weight-semibold mb-3">{text.footerExplore}</p>
        <ul>
          {
            text.nav.map((item) => (
              <li class="mb-1">
                <a href={localeUrl(locale, item.path)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="column is-4">
        <p class="has-text-weight-semibold mb-3">{text.footerVisit}</p>
        <p class="mb-1">{text.footerAddress}</p>
        <p class="mb-1">
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>

    <hr />

    <p class="is-size-7">© {year} {site.name}. {text.footerCredit}</p>
  </div>
</footer>
