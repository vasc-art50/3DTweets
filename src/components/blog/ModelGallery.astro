---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getLocale } from '../../i18n/utils';
import { ui } from '../../i18n/ui';

type BlogPost = CollectionEntry<'blog'> | CollectionEntry<'blogCs'>;

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const text = ui[locale].modelDetails;
const allAssetImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const folder = post.data.galleryFolder?.replace(/^\/+|\/+$/g, '');
const folderPrefix = folder ? `/src/assets/${folder}/` : undefined;
const folderImages = folderPrefix
  ? Object.entries(allAssetImages)
      .filter(([path]) => path.startsWith(folderPrefix))
      .sort(([first], [second]) => first.localeCompare(second))
      .map(([, image]) => image.default)
  : [];
const legacyImages = post.data.gallery ?? [];
const sourceImages = folderImages.length > 0 ? folderImages : legacyImages;
const mainImage = post.data.heroImage ?? legacyImages[0] ?? folderImages[0];
const images: ImageMetadata[] = [];
const seenSources = new Set<string>();

if (mainImage) {
  images.push(mainImage);
  seenSources.add(mainImage.src);
}

for (const image of sourceImages) {
  if (!seenSources.has(image.src)) {
    images.push(image);
    seenSources.add(image.src);
  }
}

const outputDimensions = (image: ImageMetadata, maxDimension: number) => {
  const scale = Math.min(1, maxDimension / Math.max(image.width, image.height));
  return {
    width: Math.max(1, Math.round(image.width * scale)),
    height: Math.max(1, Math.round(image.height * scale)),
  };
};

const slides = await Promise.all(
  images.map(async (image, index) => {
    const fullDimensions = outputDimensions(image, 1600);
    const thumbnailDimensions = outputDimensions(image, 300);
    const [full, thumbnail] = await Promise.all([
      getImage({
        src: image,
        ...fullDimensions,
        format: 'webp',
        quality: 82,
      }),
      getImage({
        src: image,
        ...thumbnailDimensions,
        format: 'webp',
        quality: 75,
      }),
    ]);

    return {
      fullSrc: full.src,
      fullWidth: fullDimensions.width,
      fullHeight: fullDimensions.height,
      thumbnailSrc: thumbnail.src,
      thumbnailWidth: thumbnailDimensions.width,
      thumbnailHeight: thumbnailDimensions.height,
      alt: `${post.data.title} — ${text.gallery} ${index + 1}`,
    };
  }),
);
---

{
  slides.length > 0 && (
    <div
      class="model-gallery mb-6"
      data-model-gallery
      data-active-index="0"
      role="region"
      aria-label={text.gallery}
      tabindex="0"
    >
      <div class="hero-stage">
        <img
          class="hero-stage__background"
          src={slides[0].fullSrc}
          width={slides[0].fullWidth}
          height={slides[0].fullHeight}
          alt=""
          aria-hidden="true"
          decoding="async"
        />
        <img
          class="hero-stage__image"
          src={slides[0].fullSrc}
          width={slides[0].fullWidth}
          height={slides[0].fullHeight}
          alt={slides[0].alt}
          data-gallery-image
          loading="eager"
          decoding="async"
        />
        {slides.length > 1 && (
          <>
            <button
              class="gallery-arrow gallery-arrow--previous"
              type="button"
              data-gallery-previous
              aria-label={text.previousPhoto}
            >
              <span aria-hidden="true">‹</span>
            </button>
            <button
              class="gallery-arrow gallery-arrow--next"
              type="button"
              data-gallery-next
              aria-label={text.nextPhoto}
            >
              <span aria-hidden="true">›</span>
            </button>
          </>
        )}
      </div>

      {slides.length > 1 && (
        <div class="thumbnail-strip" role="group" aria-label={text.gallery}>
          {slides.map((slide, index) => (
            <button
              class="thumbnail"
              type="button"
              data-gallery-thumb
              data-gallery-index={index}
              data-full-src={slide.fullSrc}
              data-full-width={slide.fullWidth}
              data-full-height={slide.fullHeight}
              data-full-alt={slide.alt}
              aria-label={`${text.gallery} ${index + 1}`}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span class="thumbnail__frame">
                <img
                  class="thumbnail__background"
                  src={slide.thumbnailSrc}
                  width={slide.thumbnailWidth}
                  height={slide.thumbnailHeight}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="thumbnail__image"
                  src={slide.thumbnailSrc}
                  width={slide.thumbnailWidth}
                  height={slide.thumbnailHeight}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </button>
          ))}
        </div>
      )}
    </div>
  )
}

<script is:inline>
  (() => {
    if (document.documentElement.dataset.modelGalleryInitialized) return;
    document.documentElement.dataset.modelGalleryInitialized = 'true';

    const showSlide = (gallery, index) => {
      const thumbnails = Array.from(gallery.querySelectorAll('[data-gallery-thumb]'));
      if (thumbnails.length < 2) return;

      const activeIndex = ((index % thumbnails.length) + thumbnails.length) % thumbnails.length;
      const thumbnail = thumbnails[activeIndex];
      const image = gallery.querySelector('[data-gallery-image]');
      const background = gallery.querySelector('.hero-stage__background');
      if (!image || !background || !thumbnail.dataset.fullSrc) return;

      image.src = thumbnail.dataset.fullSrc;
      image.width = Number(thumbnail.dataset.fullWidth);
      image.height = Number(thumbnail.dataset.fullHeight);
      image.alt = thumbnail.dataset.fullAlt ?? '';
      background.src = thumbnail.dataset.fullSrc;
      background.width = image.width;
      background.height = image.height;
      gallery.dataset.activeIndex = String(activeIndex);

      thumbnails.forEach((item, itemIndex) => {
        item.setAttribute('aria-pressed', String(itemIndex === activeIndex));
      });

      thumbnail.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    };

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const control = event.target.closest(
        '[data-gallery-thumb], [data-gallery-previous], [data-gallery-next]',
      );
      const gallery = control?.closest('[data-model-gallery]');
      if (!control || !gallery) return;

      if (control.matches('[data-gallery-thumb]')) {
        showSlide(gallery, Number(control.dataset.galleryIndex));
        return;
      }

      const currentIndex = Number(gallery.dataset.activeIndex ?? 0);
      showSlide(
        gallery,
        currentIndex + (control.matches('[data-gallery-next]') ? 1 : -1),
      );
    });

    document.addEventListener('keydown', (event) => {
      if (!(event.target instanceof Element)) return;
      const gallery = event.target.closest('[data-model-gallery]');
      if (!gallery || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;

      event.preventDefault();
      const currentIndex = Number(gallery.dataset.activeIndex ?? 0);
      showSlide(gallery, currentIndex + (event.key === 'ArrowRight' ? 1 : -1));
    });
  })();
</script>
