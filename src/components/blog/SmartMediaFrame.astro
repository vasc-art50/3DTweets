---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  aspectRatio?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, aspectRatio = '16 / 9', loading = 'lazy' } = Astro.props;
const dimensions = typeof src === 'string' ? { width: 1600, height: 900 } : {};
---

<div class="media-frame" style={`--media-aspect-ratio: ${aspectRatio}`}>
  <Image
    src={src}
    alt=""
    aria-hidden="true"
    class="media-frame__background"
    loading={loading}
    {...dimensions}
  />
  <Image
    src={src}
    alt={alt}
    class="media-frame__foreground"
    loading={loading}
    {...dimensions}
  />
</div>

<style>
  .media-frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    aspect-ratio: var(--media-aspect-ratio, 16 / 9);
    border-radius: var(--bulma-radius-large, 0.75rem);
    background: var(--aw-ink-soft);
  }

  .media-frame__background,
  .media-frame__foreground {
    display: block;
    width: 100%;
    height: 100%;
  }

  .media-frame__background {
    position: absolute;
    inset: 0;
    object-fit: cover;
    filter: blur(18px) var(--aw-media-backdrop-tone);
    opacity: var(--aw-media-backdrop-opacity);
    transform: scale(1.15);
    pointer-events: none;
  }

  .media-frame__foreground {
    position: relative;
    z-index: 1;
    object-fit: contain;
  }
</style>
