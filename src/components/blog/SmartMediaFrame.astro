---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  className?: string;
  aspectRatio?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, className, aspectRatio = '16 / 9', loading = 'lazy' } = Astro.props;
---

<div class:list={['aw-media-frame', className]} style={`--media-aspect-ratio: ${aspectRatio}`}>
  <Image
    src={src}
    alt=""
    aria-hidden="true"
    class="aw-media-frame__background"
    loading={loading}
  />
  <Image
    src={src}
    alt={alt}
    class="aw-media-frame__foreground"
    loading={loading}
  />
</div>
