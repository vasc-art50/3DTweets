---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  lang: 'en' | 'cs';
}

interface Material {
  name: string;
  manufacturer: string;
  type: string;
  description: string;
}

const { lang } = Astro.props;
const materialsPath = resolve(process.cwd(), 'src', 'data', lang, 'materials.csv');
const csv = readFileSync(materialsPath, 'utf8');

// Source material list: https://3dtweets.webnode.cz/seznam-materialu/
function parseMaterials(source: string): Material[] {
  source = source.replace(/^\uFEFF/, '');
  const firstLine = source.split(/\r?\n/, 1)[0] ?? '';
  const delimiter = firstLine.includes(';') ? ';' : ',';
  const rows: string[][] = [];
  let row: string[] = [];
  let field = '';
  let inQuotes = false;
  let afterQuote = false;

  for (let i = 0; i < source.length; i += 1) {
    const character = source[i];

    if (inQuotes) {
      if (character === '"' && source[i + 1] === '"') {
        field += '"';
        i += 1;
      } else if (character === '"') {
        inQuotes = false;
        afterQuote = true;
      } else {
        field += character;
      }
    } else if (afterQuote && character === delimiter) {
      row.push(field.trim());
      field = '';
      afterQuote = false;
    } else if (afterQuote && (character === '\n' || character === '\r')) {
      row.push(field.trim());
      if (row.some((value) => value !== '')) rows.push(row);
      row = [];
      field = '';
      afterQuote = false;
      if (character === '\r' && source[i + 1] === '\n') i += 1;
    } else if (afterQuote && /\s/.test(character)) {
      continue;
    } else if (afterQuote) {
      throw new Error(`Unexpected character after quoted field in ${materialsPath}`);
    } else if (character === '"' && field.trim() === '') {
      field = '';
      inQuotes = true;
    } else if (character === delimiter) {
      row.push(field.trim());
      field = '';
    } else if (character === '\n' || character === '\r') {
      row.push(field.trim());
      if (row.some((value) => value !== '')) rows.push(row);
      row = [];
      field = '';
      if (character === '\r' && source[i + 1] === '\n') i += 1;
    } else {
      field += character;
    }
  }

  if (inQuotes) throw new Error(`Unclosed quoted field in ${materialsPath}`);
  row.push(field.trim());
  if (row.some((value) => value !== '')) rows.push(row);

  const header = rows.shift()?.map((value) => value.trim());
  const requiredColumns = ['name', 'manufacturer', 'type', 'description'];
  if (!header || requiredColumns.some((column) => !header.includes(column))) {
    throw new Error(`Invalid materials CSV header in ${materialsPath}`);
  }

  const descriptionIndex = header.indexOf('description');
  return rows.map((fields, index) => {
    if (fields.length > header.length && descriptionIndex === header.length - 1) {
      fields = [...fields.slice(0, header.length - 1), fields.slice(header.length - 1).join(`${delimiter} `)];
    }

    if (fields.length !== header.length) {
      throw new Error(`Expected ${header.length} columns on CSV row ${index + 2} in ${materialsPath}`);
    }

    const getValue = (column: string): string => {
      const columnIndex = header.indexOf(column);
      const value = fields[columnIndex];
      if (value === undefined) {
        throw new Error(`Missing ${column} value on CSV row ${index + 2} in ${materialsPath}`);
      }
      return value;
    };

    return {
      name: getValue('name'),
      manufacturer: getValue('manufacturer'),
      type: getValue('type'),
      description: getValue('description'),
    };
  });
}

const materials = parseMaterials(csv);
---

<div class="columns is-multiline is-variable is-6">
  {
    materials.map((item) => (
      <div class="column is-6-tablet is-12-mobile">
        <div
          style="display: flex; flex-direction: column; justify-content: space-between; height: 100%; padding-bottom: 1rem; border-bottom: 1px solid var(--bulma-border, rgba(128, 128, 128, 0.25));"
        >
          <div
            style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.4rem;"
          >
            <span><strong>{item.name}</strong> - <em>{item.manufacturer}</em></span>
            <strong style="text-transform: uppercase; white-space: nowrap; color: var(--aw-accent);">
              {item.type}
            </strong>
          </div>
          <p class="is-size-6">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
