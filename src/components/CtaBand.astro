---
import { getLocale, localeUrl } from '../i18n/utils';
import { ui } from '../i18n/ui';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const locale = getLocale(Astro.currentLocale);
const defaults = ui[locale];
const { eyebrow = defaults.ctaEyebrow, title = defaults.ctaTitle, text = defaults.ctaText, ctaLabel = defaults.ctaButton, ctaHref = '/contact' } = Astro.props;
---

<section class="section aw-section">
  <div class="container">
    <div class="aw-cta has-text-centered">
      {eyebrow && <p class="aw-eyebrow mb-3">{eyebrow}</p>}
      <h2 class="title is-2 mb-3">{title}</h2>
      {text && <p class="subtitle is-5 mb-5 aw-cta-text">{text}</p>}
      <a class="button is-primary is-large" href={localeUrl(locale, ctaHref)}>{ctaLabel}</a>
    </div>
  </div>
</section>
