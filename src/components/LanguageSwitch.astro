---
import type { Locale } from '../i18n/ui';
import { localeSwitchUrl } from '../i18n/utils';

interface Props {
  locale: Locale;
  pathname: string;
  idSuffix: 'mobile' | 'desktop';
}

const { locale, pathname, idSuffix } = Astro.props;
const target = locale === 'en' ? 'cs' : 'en';
const switchUrl = localeSwitchUrl(pathname, target);
const clipId = `aw-pill-cs-${idSuffix}`;
---

<div class="aw-lang-switch" data-lang={locale}>
  <span class="aw-lang-label aw-lang-en">EN</span>
  <a
    class="aw-lang-pill"
    href={switchUrl}
    hreflang={target}
    aria-label={locale === 'en' ? 'Switch language to Czech' : 'Přepnout jazyk do angličtiny'}
  >
    {locale === 'en' ? (
      <svg class="aw-lang-icon aw-lang-globe" viewBox="0 0 38 20" width="38" height="20" aria-hidden="true">
        <g transform="translate(26, 10)" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round">
          <circle cx="0" cy="0" r="6" />
          <ellipse cx="0" cy="0" rx="2.8" ry="6" />
          <line x1="-6" y1="0" x2="6" y2="0" />
          <path d="M -4.8 -3 Q 0 -1.8 4.8 -3" />
          <path d="M -4.8 3 Q 0 1.8 4.8 3" />
        </g>
      </svg>
    ) : (
      <svg class="aw-lang-flag" viewBox="0 0 38 20" width="38" height="20" aria-hidden="true">
        <defs><clipPath id={clipId}><rect width="38" height="20" rx="10" /></clipPath></defs>
        <g clip-path={`url(#${clipId})`}>
          <rect width="38" height="10" y="0" fill="#ffffff" />
          <rect width="38" height="10" y="10" fill="#D7141A" />
          <polygon points="0,0 18,10 0,20" fill="#11457E" />
        </g>
      </svg>
    )}
    <span class="aw-lang-thumb" aria-hidden="true"></span>
  </a>
  <span class="aw-lang-label aw-lang-cs">CZ</span>
</div>
