---
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { team, values } from '../data/team';
---

<BaseLayout
  title="About"
  description="3DTweets is a young team focused on 3D design, prototyping, and functional printing."
>
  <PageHero
    eyebrow="About us"
    title="3DTweets"
    subtitle="A young, ambitious team focused on 3D design, product development, and practical printing. We turn ideas into useful things with care, creativity, and a strong eye for what actually works."
    compact
  />

  <section class="section aw-section">
    <div class="container">
      <div class="columns is-vcentered">
        <div class="column is-7">
          <h2 class="title is-2 mb-4">Why we exist</h2>
          <div class="content">
            <p>
              We started our 3D printing journey in 2020 with an Ender 3 Pro,
              learning the basics of printer maintenance, calibration, tuning,
              and the steady work required to get reliable results.
            </p>
            <p>
              In 2023, we upgraded to an Original Prusa MK4, which made our
              workflow faster and helped us bring new ideas and models to life
              with much less friction.
            </p>
            <p>
              Our goal is simple: find the best balance between print quality and
              effort, and keep solving real problems with creativity, precision,
              and practical thinking.
            </p>
          </div>
        </div>
        <div class="column is-5">
          <div class="box aw-hero-box">
            <p class="aw-eyebrow mb-3">The short version</p>
            <ul class="content">
              <li>Started in 2020 with Ender 3 Pro</li>
              <li>Upgraded to Original Prusa MK4 in 2023</li>
              <li>Building practical, print-ready ideas every day</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">What guides us</p>
        <h2 class="title is-2">Our values</h2>
      </div>

      <div class="columns">
        {
          values.map((value, index) => (
            <div class="column is-4">
              <div class="box aw-card">
                <p class="aw-value-number mb-2">{String(index + 1).padStart(2, '0')}</p>
                <h3 class="title is-5">{value.title}</h3>
                <p>{value.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section aw-section">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">The team</p>
        <h2 class="title is-2">Makers, designers, and problem-solvers</h2>
        <p class="subtitle is-6">A compact workshop mindset with a strong focus on useful results.</p>
      </div>

      <div class="columns">
        {
          team.map((member) => (
            <div class="column is-3">
              <div class="box aw-card">
                <div class="is-flex is-align-items-center mb-4">
                  <span class="aw-avatar mr-4" aria-hidden="true">{member.initials}</span>
                  <div>
                    <h3 class="title is-5 mb-1">{member.name}</h3>
                    <p class="aw-form-note">{member.role}</p>
                  </div>
                </div>
                <p>{member.bio}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Come see what we build"
    title="The best way to decide is to start with a conversation."
    text="Tell us about your idea, your part, or your product challenge, and we will help you choose the most practical next step."
  />
</BaseLayout>
