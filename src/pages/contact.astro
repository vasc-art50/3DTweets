---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getLocale } from '../i18n/utils';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const text = ui[locale].form;
---

<BaseLayout
  title={text.contact}
  description={locale === 'cs'
    ? 'Ozvěte se nám s poptávkou 3D modelu, prototypu, zakázkového tisku nebo s dotazem k nastavení tiskárny.'
    : 'Get in touch about a custom 3D model, prototype, print project, or printer setup question.'}
>
  <PageHero
    eyebrow={text.contact}
    title={text.title}
    subtitle={text.subtitle}
    compact
  />

  <section class="section aw-section">
    <div class="container">
      <div class="columns">
        <div class="column is-5">
          <h2 class="title is-4">{text.getInTouch}</h2>
          <div class="aw-contact-list">
            <div>
              <p class="aw-contact-label mb-1">{text.location}</p>
              <p>{locale === 'cs' ? 'Praha · Česká republika' : site.address}</p>
            </div>
            <div>
              <p class="aw-contact-label mb-1">Email</p>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </div>
            <div>
              <p class="aw-contact-label mb-1">{text.workingHours}</p>
              <p>
                {text.hours}<br />
                {text.saturday}<br />
                {text.sunday}
              </p>
            </div>
          </div>

          <div class="aw-notice mt-5">
            {text.notice}
          </div>
        </div>

        <div class="column is-6 is-offset-1">
          <h2 class="title is-4">{text.sendMessage}</h2>

          <!-- Web3Forms Dashboard & správa zpráv: https://app.web3forms.com/dashboard -->
          <form
            id="form"
            action="https://api.web3forms.com/submit"
            method="POST"
            data-sending={text.sending}
            data-success={text.success}
            data-error={text.error}
            data-send-label={text.send}
          >
            <input type="hidden" name="access_key" value="4cf29cb0-e309-468d-b2d0-3c6da8fb0e6b" />
            <input type="checkbox" name="botcheck" style="display: none;" />
            <div class="field">
              <label class="label" for="contact-name">{text.name}</label>
              <div class="control">
                <input
                  class="input"
                  id="contact-name"
                  name="name"
                  type="text"
                  placeholder={text.namePlaceholder}
                  autocomplete="name"
                  required
                />
              </div>
            </div>

            <div class="field">
              <label class="label" for="contact-email">{text.email}</label>
              <div class="control">
                <input
                  class="input"
                  id="contact-email"
                  name="email"
                  type="email"
                  placeholder={text.emailPlaceholder}
                  autocomplete="email"
                  required
                />
              </div>
            </div>

            <div class="field">
              <label class="label" for="contact-interest">{text.interest}</label>
              <div class="control">
                <div class="select is-fullwidth">
                  <select id="contact-interest" name="interest" required>
                    {text.interests.map((interest) => <option value={interest}>{interest}</option>)}
                  </select>
                </div>
              </div>
            </div>

            <div class="field">
              <label class="label" for="contact-message">{text.message}</label>
              <div class="control">
                <textarea
                  class="textarea"
                  id="contact-message"
                  name="message"
                  placeholder={text.messagePlaceholder}
                  rows="5"
                  required></textarea>
              </div>
              <p class="help">{text.replyTime}</p>
            </div>

            <div class="field">
              <div class="control">
                <button class="button is-primary" type="submit">{text.send}</button>
              </div>
            </div>
            <div id="form-result" class="notification is-hidden mt-4" role="status" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Manage the access key and submitted messages at https://app.web3forms.com/dashboard.
  document.addEventListener('submit', async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || form.id !== 'form') return;

    event.preventDefault();

    const result = form.querySelector<HTMLDivElement>('#form-result');
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!result || !submitButton) return;

    const sendLabel = form.dataset.sendLabel ?? submitButton.textContent ?? '';
    result.classList.add('is-hidden');
    result.classList.remove('is-success', 'is-danger');
    result.textContent = '';
    submitButton.disabled = true;
    submitButton.textContent = form.dataset.sending ?? '';

    const showResult = (success: boolean) => {
      result.classList.remove('is-hidden');
      result.classList.add(success ? 'is-success' : 'is-danger');
      result.textContent = success ? form.dataset.success ?? '' : form.dataset.error ?? '';
    };

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form),
        headers: {
          Accept: 'application/json',
        },
      });

      if (!response.ok) {
        console.error(`Web3Forms request failed: ${response.status} ${response.statusText}`);
        showResult(false);
        return;
      }

      showResult(true);
      form.reset();
    } catch (error) {
      console.error('Web3Forms request failed.', error);
      showResult(false);
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = sendLabel;
    }
  });
</script>
