---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getLocale } from '../i18n/utils';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const text = ui[locale].form;
---

<BaseLayout
  title={text.contact}
  description={locale === 'cs'
    ? 'Ozvěte se nám s poptávkou 3D modelu, prototypu, zakázkového tisku nebo s dotazem k nastavení tiskárny.'
    : 'Get in touch about a custom 3D model, prototype, print project, or printer setup question.'}
>
  <PageHero
    eyebrow={text.contact}
    title={text.title}
    subtitle={text.subtitle}
    compact
  />

  <section class="section aw-section">
    <div class="container">
      <div class="columns">
        <div class="column is-5">
          <h2 class="title is-4">{text.getInTouch}</h2>
          <div class="aw-contact-list">
            <div>
              <p class="aw-contact-label mb-1">{text.location}</p>
              <p>{locale === 'cs' ? 'Praha · Česká republika' : site.address}</p>
            </div>
            <div>
              <p class="aw-contact-label mb-1">Email</p>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </div>
            <div>
              <p class="aw-contact-label mb-1">{text.workingHours}</p>
              <p>
                {text.hours}<br />
                {text.saturday}<br />
                {text.sunday}
              </p>
            </div>
          </div>

          <div class="aw-notice mt-5">
            {text.notice}
          </div>
        </div>

        <div class="column is-6 is-offset-1">
          <h2 class="title is-4">{text.sendMessage}</h2>

          <form
            id="contact-form"
            data-email={site.email}
            data-subject-label={text.subject}
            data-opening-status={text.openingEmail}
          >
            <div class="field">
              <label class="label" for="contact-name">{text.name}</label>
              <div class="control">
                <input
                  class="input"
                  id="contact-name"
                  name="name"
                  type="text"
                  placeholder={text.namePlaceholder}
                  autocomplete="name"
                  required
                />
              </div>
            </div>

            <div class="field">
              <label class="label" for="contact-email">{text.email}</label>
              <div class="control">
                <input
                  class="input"
                  id="contact-email"
                  name="email"
                  type="email"
                  placeholder={text.emailPlaceholder}
                  autocomplete="email"
                  required
                />
              </div>
            </div>

            <div class="field">
              <label class="label" for="contact-interest">{text.interest}</label>
              <div class="control">
                <div class="select is-fullwidth">
                  <select id="contact-interest" name="interest">
                    {text.interests.map((interest) => <option>{interest}</option>)}
                  </select>
                </div>
              </div>
            </div>

            <div class="field">
              <label class="label" for="contact-message">{text.message}</label>
              <div class="control">
                <textarea
                  class="textarea"
                  id="contact-message"
                  name="message"
                  placeholder={text.messagePlaceholder}
                  rows="5"
                  required></textarea>
              </div>
              <p class="help">{text.replyTime}</p>
            </div>

            <div class="field">
              <div class="control">
                <button class="button is-primary" type="submit">{text.send}</button>
              </div>
            </div>

            <p id="contact-form-status" class="aw-form-note" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // The site is fully static, so the form composes an email in the visitor's
  // mail client instead of pretending to POST to a backend that does not exist.
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-form-status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const email = form.dataset.email ?? '';
    const name = String(data.get('name') ?? '');
    const from = String(data.get('email') ?? '');
    const interest = String(data.get('interest') ?? '');
    const message = String(data.get('message') ?? '');

    const subjectLabel = form.dataset.subjectLabel ?? 'Website enquiry';
    const openingStatus = form.dataset.openingStatus ?? 'Opening your email client…';
    const subject = encodeURIComponent(`${subjectLabel}: ${interest}`);
    const body = encodeURIComponent(`${message}\n\n— ${name} (${from})`);

    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;

    if (status) {
      status.textContent = openingStatus;
    }
  });
</script>
