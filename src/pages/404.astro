---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="Looks like this page turned into filament spaghetti. Head back to the 3DTweets home page to recalibrate and keep exploring."
>
  <PageHero
    eyebrow="Error 404"
    title="Page not found."
    subtitle="The page you are looking for has been moved, renamed, or never got sliced. Let us get you back to the build plate"
    compact
  >
    <div class="buttons is-centered mt-5">
      <a class="button is-primary is-medium" href="/">Back to home</a>
      <a class="button is-medium is-outlined" href="/contact">Contact us</a>
    </div>
  </PageHero>
</BaseLayout>