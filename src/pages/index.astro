---
import CtaBand from '../components/CtaBand.astro';
import LatestPosts from '../components/LatestPosts.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { site } from '../data/site';
import { testimonials } from '../data/testimonials';

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.description,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Prague',
    addressLocality: 'Prague',
    addressRegion: 'Prague',
    addressCountry: 'CZ',
  },
  areaServed: 'Czech Republic',
  openingHours: ['Mo-Fr 09:00-18:00'],
};

const featuredServices = services.slice(0, 3);

const stats = [
  { value: '2020', label: 'First printer' },
  { value: 'MK4', label: 'Current printer setup' },
  { value: '3D', label: 'Design · print · build' },
  { value: '∞', label: 'Ideas worth testing' },
];
---

<BaseLayout title={site.name} description={site.description} schema={businessSchema}>
  <PageHero
    eyebrow="DESIGN · PRINT · BUILD"
    title="Tweak your world!"
    subtitle="We turn rough ideas into practical 3D models, prototypes, and printed parts that solve real problems with the right balance of quality and effort."
  >
    <div class="buttons mt-5">
      <a class="button is-primary is-medium" href="/contact">Discuss your idea</a>
      <a class="button is-medium is-outlined" href="/services">Explore services</a>
    </div>

    <Fragment slot="aside">
      <div class="box aw-hero-box">
        <p class="aw-eyebrow mb-3">What we like to build</p>
        <ul class="content">
          <li><strong>CoreXY</strong> — practical printer experiments</li>
          <li><strong>Re-Creator</strong> — material reuse and workshop ideas</li>
          <li><strong>Smart Home</strong> — connected, useful devices</li>
        </ul>
        <p class="aw-form-note mt-4">Always happy to exchange ideas and experience.</p>
      </div>
    </Fragment>
  </PageHero>

  <section class="section aw-section" aria-label="Project stats">
    <div class="container">
      <div class="columns has-text-centered">
        {
          stats.map((stat) => (
            <div class="column">
              <span class="aw-stat-number">{stat.value}</span>
              <span class="aw-stat-label">{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">What we do</p>
        <h2 class="title is-2">Built for your 3D projects</h2>
        <p class="subtitle is-6">
          Start with a custom print or a design prototype. We grow the effort only as far as the idea needs it.
        </p>
      </div>

      <div class="columns">
        {
          featuredServices.map((service) => (
            <div class="column is-4">
              <ServiceCard {...service} />
            </div>
          ))
        }
      </div>

      <div class="has-text-centered mt-6">
        <a class="button is-medium is-outlined" href="/services">See all services</a>
      </div>
    </div>
  </section>

  <section class="section aw-section">
    <div class="container">
      <div class="columns is-vcentered">
        <div class="column is-7">
          <p class="aw-quote mb-4">
            “We do not print just for the sake of it. We design and build parts that solve
            practical problems and hold up in everyday use.”
          </p>
          <p class="has-text-weight-semibold">The 3DTweets team</p>
        </div>
        <div class="column is-5 has-text-centered">
          <a class="button is-primary is-medium" href="/contact">Discuss your idea</a>
          <p class="aw-form-note mt-3">Free initial consultation, no obligation.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">Showcase</p>
        <h2 class="title is-2">Featured builds &amp; prints</h2>
        <p class="subtitle is-6">From workshop upgrades to concept prototypes and functional printed parts.</p>
      </div>

      <div class="columns">
        {
          testimonials.map((testimonial) => (
            <div class="column is-4">
              <TestimonialCard {...testimonial} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <LatestPosts />

  <CtaBand
    eyebrow="Ready when you are"
    title="Start with a quick conversation."
    text="Share the idea, the part, or the challenge, and we will suggest the smartest next step."
    ctaLabel="Discuss your idea"
    ctaHref="/contact"
  />
</BaseLayout>
