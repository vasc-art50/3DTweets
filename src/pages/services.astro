---
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { plans } from '../data/pricing';
import { services } from '../data/services';
---

<BaseLayout
  title="Services"
  description="3D design, custom printing, prototypes, and printer tuning for practical products and workshop solutions."
>
  <PageHero
    eyebrow="Services &amp; pricing"
    title="Design, print, refine."
    subtitle="From a rough idea to a tested part or custom build, we help turn the smartest concept into something that works in the real world."
    compact
  />

  <section class="section aw-section">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">What we do</p>
        <h2 class="title is-2">Our services</h2>
      </div>

      <div class="columns is-multiline">
        {
          services.map((service) => (
            <div class="column is-4">
              <ServiceCard {...service} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">Project options</p>
        <h2 class="title is-2">Clear, straightforward project scopes</h2>
        <p class="subtitle is-6">
          Transparent planning, practical iteration, and no unnecessary complexity.
        </p>
      </div>

      <div class="columns" style="--column-gap: 1.5rem">
        {
          plans.map((plan) => (
            <div class="column is-4">
              <div class:list={['box aw-card aw-plan', { 'is-highlighted': plan.highlighted }]}>
                {plan.highlighted && <div class="aw-plan-badge">Most popular</div>}
                <h3 class="title is-4">{plan.name}</h3>
                <p class="aw-price mb-2">
                  {plan.price} <span>{plan.period}</span>
                </p>
                <p class="mb-4">{plan.description}</p>
                <ul class="aw-check-list mb-4">
                  {plan.features.map((feature) => <li>{feature}</li>)}
                </ul>
                <a
                  class:list={['button is-fullwidth', plan.highlighted ? 'is-primary' : 'is-outlined']}
                  href="/contact"
                >
                  Start with {plan.name}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Not sure where to start?"
    title="Discuss your idea and decide later."
    text="Share the idea, the problem, or the part you need and we will suggest the most practical route forward."
  />
</BaseLayout>
