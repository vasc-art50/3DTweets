---
import BlogCategoryOverview from '../../../components/blog/BlogCategoryOverview.astro';
import BlogNewsFeed from '../../../components/blog/BlogNewsFeed.astro';
import PageHero from '../../../components/PageHero.astro';
import CategoryFilter from '../../../components/blog/CategoryFilter.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localeUrl } from '../../../i18n/utils';
import { ui } from '../../../i18n/ui';

const posts = (await getCollection('blogCs')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Praktické poznámky k 3D návrhu, ladění tiskáren a vývoji prototypů z dílny 3DTweets."
>
  <div class="aw-blog-index">
    <PageHero
      eyebrow={ui.cs.blogJournal}
      title={ui.cs.blogJournalTitle}
      subtitle="Praktické články o 3D návrhu, seřizování tiskáren, prototypech a drobných vylepšeních, díky kterým projekt funguje lépe."
      compact
      className="aw-blog-page-hero"
    />
    <section class="section aw-section">
      <div class="container">
        <CategoryFilter lang="cs" />
        {posts.length > 0 ? (
          <>
            <BlogCategoryOverview posts={posts} lang="cs" />
            <BlogNewsFeed posts={posts} lang="cs" />
          </>
        ) : (
          <p class="has-text-centered">
            Zatím tu žádné články nejsou. Zastavte se později nebo nám
            <a href={localeUrl('cs', '/contact')}> napište</a>, o čem byste si chtěli přečíst.
          </p>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
