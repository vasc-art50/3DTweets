---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ModelDetailsBox from '../../../components/blog/ModelDetailsBox.astro';
import ModelGallery from '../../../components/blog/ModelGallery.astro';
import { formatDate } from '../../../utils/date';
import { readingTime } from '../../../utils/reading-time';
import { localeUrl } from '../../../i18n/utils';

interface Props {
  post: CollectionEntry<'blogCs'>;
}

export async function getStaticPaths() {
  const posts = await getCollection('blogCs');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} ogType="article" post={post}>
  <section class="section aw-section">
    <div class="container">
      <article class="aw-prose">
        <p class="aw-blog-meta mb-3">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, 'cs')}</time>
          {' · '}
          {readingTime(post.body ?? '', 'cs')}
        </p>
        <h1 class="title is-1 mb-5">{post.data.title}</h1>
        <div class="mb-6">
          {post.data.tags.map((tag) => <span class="aw-tag">#{tag}</span>)}
        </div>
        <ModelGallery post={post} />
        <ModelDetailsBox post={post} />
        <div class="aw-markdown-body">
          <Content />
        </div>
      </article>
      <p class="mt-6"><a href={localeUrl('cs', '/blog')}>← Zpět na všechny články</a></p>
    </div>
  </section>
</BaseLayout>
