---
import { getCollection } from 'astro:content';
import TweetOneContent from '../../components/TweetOneContent.astro';

const sections = (await getCollection('tweetone', ({ id }) => id.startsWith('cs/'))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<TweetOneContent locale="cs" sections={sections} />
