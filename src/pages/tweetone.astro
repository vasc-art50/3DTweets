---
import { getCollection } from 'astro:content';
import TweetOneContent from '../components/TweetOneContent.astro';

const sections = (await getCollection('tweetone', ({ id }) => id.startsWith('en/'))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<TweetOneContent locale="en" sections={sections} />
