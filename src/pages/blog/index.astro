---
import BlogCategoryOverview from '../../components/blog/BlogCategoryOverview.astro';
import BlogNewsFeed from '../../components/blog/BlogNewsFeed.astro';
import PageHero from '../../components/PageHero.astro';
import CategoryFilter from '../../components/blog/CategoryFilter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ui } from '../../i18n/ui';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Practical notes on 3D design, printer tuning, and building better prototypes from the 3DTweets workshop."
>
  <div class="aw-blog-index">
    <PageHero
      eyebrow={ui.en.blogJournal}
      title={ui.en.blogJournalTitle}
      subtitle="Practical write-ups on 3D design, printer tuning, prototypes, and the small improvements that make a project work better."
      compact
      className="aw-blog-page-hero"
    />

    <section class="section aw-section">
      <div class="container">
        <CategoryFilter lang="en" />
        {
          posts.length > 0 ? (
            <>
              <BlogCategoryOverview posts={posts} lang="en" />
              <BlogNewsFeed posts={posts} lang="en" />
            </>
          ) : (
            <p class="has-text-centered">
              No posts yet. Check back soon — or <a href="/contact">tell us</a> what
              you would like us to write about.
            </p>
          )
        }
      </div>
    </section>
  </div>
</BaseLayout>
